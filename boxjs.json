{
  "id": "ader90520.app.sub",
  "name": "福利吧签到（自用修正版）",
  "description": "福利吧自动签到，兼容BoxJs",
  "author": "@ader90520",
  "icon": "https://raw.githubusercontent.com/leiyiyan/resource/main/icons/pyy.png",
  "repo": "https://github.com/ader90520/QuantumultX",
  "apps": [
    {
      "id": "fuba_sign",
      "name": "福利吧签到",
      "author": "@ader90520",
      "repo": "https://github.com/ader90520/QuantumultX",
      "icons": [
        "https://raw.githubusercontent.com/leiyiyan/resource/main/icons/pyy.png",
        "https://raw.githubusercontent.com/leiyiyan/resource/main/icons/pyy.png"
      ],
      "keys": [
        "fuba_cookie",
        "fuba_username",
        "fuba_domain",
        "fuba_last_sign_date",
        "fuba_continuous_days",
        "fuba_total_days"
      ],
      "settings": [
        {
          "id": "fuba_domain",
          "name": "福利吧域名",
          "val": "www.wnflb2023.com",
          "type": "select",
          "options": [
            { "name": "wnflb2023.com", "val": "www.wnflb2023.com" },
            { "name": "wnflb00.com", "val": "www.wnflb00.com" },
            { "name": "wnflb99.com", "val": "www.wnflb99.com" },
            { "name": "wnflb77.com", "val": "www.wnflb77.com" }
          ],
          "desc": "选择福利吧访问域名"
        },
        {
          "id": "fuba_cookie",
          "name": "福利吧Cookie",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "placeholder": "通过圈X重写规则自动获取",
          "desc": "已配置自动获取"
        },
        {
          "id": "fuba_username",
          "name": "福利吧用户名",
          "val": "",
          "type": "text",
          "placeholder": "自动获取",
          "desc": "自动获取"
        },
        {
          "id": "fuba_last_sign_date",
          "name": "最后签到日期",
          "val": "",
          "type": "text",
          "placeholder": "自动记录",
          "desc": "自动记录"
        },
        {
          "id": "fuba_continuous_days",
          "name": "连续签到天数",
          "val": "0",
          "type": "number",
          "desc": "自动记录"
        },
        {
          "id": "fuba_total_days",
          "name": "总签到天数",
          "val": "0",
          "type": "number",
          "desc": "自动记录"
        },
        {
          "id": "@fuba.auto_get",
          "name": "自动获取状态",
          "val": false,
          "type": "boolean",
          "desc": "显示是否已自动获取"
        },
        {
          "id": "@fuba.debug_mode",
          "name": "调试模式",
          "val": false,
          "type": "boolean",
          "desc": "开启详细日志"
        }
      ],
      "scripts": [
        {
          "script": "https://raw.githubusercontent.com/ader90520/QuantumultX/refs/heads/main/Stripts/myScripts/fuba/fuba.js"
        }
      ],
      "desc_html": [
        "<h3>福利吧自动签到脚本</h3>",
        "<p>Cookie和用户名已配置自动获取，无需手动填写</p>"
      ]
    }
  ]
}